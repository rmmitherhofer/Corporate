		<PackageReference Include="Zypher.Persistence.Abstractions" Version="1.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Building Blocks\Core\Extensions\Extensions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\fonts\GothamBold.ttf">
