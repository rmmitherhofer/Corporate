{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "None"
    }
  },
  "AllowedHosts": "*",
  "NedMonitor": {
    "ProjectId": "be0a8f65-ab7a-4a34-b65c-6683f45901fb",
    "ProjectType": "webapp",

    "MinimumLogLevel": "Information",

    "ExecutionMode": {
      "EnableMonitorExceptions": true,
      "EnableMonitorNotifications": true,
      "EnableMonitorLogs": true,
      "EnableMonitorHttpRequests": true
    },

    "HttpLogging": {
      "WritePayloadToConsole": false ,
      "CaptureResponseBody": false,
      "MaxResponseBodySizeInMb": 1,
      "CaptureCookies": true
    },

    "SensitiveDataMasking": {
      "Enabled": true,
      "SensitiveKeys": [],
      "SensitivePatterns": [],
      "MaskValue": "**SENSURADO**"
    },

    "Exceptions": {
      "Expected": []
    },
    "RemoteService": {
      "Endpoints": {
        "NotifyLogContext": "api/v1/logs/context"
      }
    }
  }
}
