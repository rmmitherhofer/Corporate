{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "None"
    }
  },
  "AllowedHosts": "*",
  "Apis": {
    "Candidato": "http://localhost:6060",
    "Cliente": "http://localhost:6061",
    "Vaga": "http://localhost:6062",
    "TalentMind": "https://talent-mind-api.dev.rh.solucao.com.br"
  },
  "NedMonitor": {
    "ProjectId": "be0a8f65-ab7a-4a34-b65c-6683f45901fb",
    "ProjectType": "webapp",

    "MinimumLogLevel": "Information",

    "ExecutionMode": {
      "EnableNedMonitor": true,
      "EnableMonitorExceptions": true,
      "EnableMonitorNotifications": true,
      "EnableMonitorLogs": true,
      "EnableMonitorHttpRequests": true
    },

    "HttpLogging": {
      "WritePayloadToConsole": false ,
      "CaptureResponseBody": false,
      "MaxResponseBodySizeInMb": 1,
      "CaptureCookies": true
    },

    "SensitiveDataMasking": {
      "Enabled": false,
      "SensitiveKeys": [],
      "SensitivePatterns": [
        "\\b\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}\\b", // CPF
        "\\b\\d{2}\\.?\\d{3}\\.?\\d{3}/?\\d{4}-?\\d{2}\\b" // CNPJ
      ],
      "MaskValue": "***"
    },

    "Exceptions": {
      "Expected": []
    },
    "RemoteService": {
      "BaseAddress": "https://ned-monitor-api.dev.rh.solucao.com.br",
      "Endpoints": {
        "NotifyLogContext": "api/v1/logs/context"
      }
    }
  }
}
