@model ClienteViewModel

<form asp-controller="Cliente" asp-action="New" method="post" class="row g-3">
    <input asp-for="Id" type="hidden" />
    <div class="col-md-6">
        <label for="txt-cnpj" class="form-label">CNPJ</label>
        <input asp-for="Cnpj" type="text" class="form-control" id="txt-cnpj">
    </div>
    <div class="col-md-6">
        <label for="txt-nome" class="form-label">Nome</label>
        <input asp-for="NomeFantasia" type="text" class="form-control" id="txt-nome">
    </div>
    <div class="col-md-6">
        <label for="txt-representante" class="form-label">Representante</label>
        <input asp-for="NomeRepresentante" type="text" class="form-control" id="txt-representante">
    </div>
    <div class="col-md-6">
        <label for="txt-telefone" class="form-label">Telefone</label>
        <input asp-for="Telefone" type="text" class="form-control" id="txt-telefone">
    </div>
    <div class="col-md-6">
        <label for="txt-email" class="form-label">E-mail</label>
        <input asp-for="Email" type="email" class="form-control" id="txt-email">
    </div>    
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Cadastrar</button>
    </div>
</form>