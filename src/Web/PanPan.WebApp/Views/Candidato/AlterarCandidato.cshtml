@using PanPan.WebApp.Components;
@using PanPan.WebApp.Extensions;
@model CandidatoViewModel
<form asp-controller="Candidato" asp-action="AlterarCandidato" method="post" class="row g-3">
    <div class="box">
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-codigo" class="label">Codigo</label>
                    <div class="control">
                        <input id="txt-codigo" asp-for="Codigo" type="number" name="Codigo" class="input" placeholder="00000" maxlength="35" readonly>
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="slct-status" class="label">Status</label>
                    <div class="control">
                        <div>
                            <select id="slct-status" asp-for="Status" name="Status" class="selectize" placeholder="Selecione">
                                <option></option>
                                @{
                                    if (Model is not null)
                                        @Html.Raw(this.SelectOptionsStatusCandidato(Model.Status))
                                    else
                                        @Html.Raw(this.SelectOptionsStatusCandidato())
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-apelido" class="label">Apelido</label>
                    <div class="control">
                        <input id="txt-apelido" asp-for="Apelido" type="text" name="Apelido" class="input" placeholder="Apelido" maxlength="35">
                    </div>
                </div>
            </div>
            <div class="column"></div>
        </div>

        <partial name="Partial/_Candidato" model="Model" />

        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-data-nascimento" class="label">Data de nascimento</label>
                    <div class="control">
                        <input id="txt-data-nascimento" asp-for="DataNascimento" type="text" name="DataNascimento" class="input" placeholder="00/00/0000" data-mask="00/00/0000">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-idade" class="label">Idade</label>
                    <div class="control">
                        <input id="txt-idade" asp-for="Idade" type="number" name="Idade" class="input" placeholder="0">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-naturalidade" class="label">Naturalidade</label>
                    <div class="control">
                        <input id="txt-naturalidade" asp-for="Naturalidade" type="text" name="Naturalidade" class="input" placeholder="Cidade-UF" maxlength="150">
                    </div>
                </div>
            </div>
        </div>

        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="slct-estado-civil" class="label">Estado civil</label>
                    <div class="control">
                        <div>
                            <select id="slct-estado-civil" asp-for="StatusCivil" name="StatusCivil" class="selectize" placeholder="Selecione">
                                <option></option>
                                @{
                                    if (Model is not null)
                                        @Html.Raw(this.SelectOptionsEstadoCivil(Model.StatusCivil))
                                    else
                                        @Html.Raw(this.SelectOptionsEstadoCivil())
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-quantidade-filhos" class="label">Quantidade de filhos</label>
                    <div class="control">
                        <input id="txt-quantidade-filhos" asp-for="QuantidadeFilhos" type="number" name="QuantidadeFilhos" class="input" placeholder="0">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-quantidade-filhos" class="label">Idade dos filhos</label>
                    <div class="control">
                        <input id="txt-quantidade-filhos" asp-for="IdadeFilhos" type="text" name="IdadeFilhos" class="input" placeholder="0, 0 e 0 anos" maxlength="30">
                    </div>
                </div>
            </div>
        </div>

        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="slct-cnh" class="label">CNH</label>
                    <div class="control">
                        <div>
                            <select id="slct-cnh" asp-for="CNH" name="CNH" class="selectize" placeholder="Selecione">
                                <option></option>
                                <option value="Nao possui">Nao possui</option>
                                <option value="A">A</option>
                                <option value="A e B">A e B</option>
                                <option value="A, B e C">A, B e C</option>
                                <option value="A, B, C e D">A, B, C e D</option>
                                <option value="A, B, C, D e E">A, B, C, D e E</option>
                                <option value="B">B</option>
                                <option value="B e C">B e C</option>
                                <option value="B, C e D">B, C e D</option>
                                <option value="B, C, D e E">B, C, D e E</option>
                                <option value="C">C</option>
                                <option value="C e D">C e D</option>
                                <option value="C, D e E">C, D e E</option>
                                <option value="D">D</option>
                                <option value="D e E">D e E</option>
                                <option value="E">E</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-conhecimentos" class="label">Conhecimentos</label>
                    <div class="control">
                        <input id="txt-conhecimentos" asp-for="Conhecimentos" type="text" name="Conhecimentos" class="input" placeholder="Conhecimentos" maxlength="1024">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-idiomas" class="label">Idiomas</label>
                    <div class="control">
                        <input id="txt-idiomas" asp-for="Idiomas" type="text" name="Idiomas" class="input" placeholder="Ingles avancado, espanhol basico..." maxlength="150">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-pretensao-salarial" class="label">Pretensao salarial</label>
                    <div class="control has-icons-left">
                        <input id="txt-pretensao-salarial" asp-for="PretensaoSalarial" type="text" name="PretensaoSalarial" class="input" placeholder="00.000,00" maxlength="17" onkeyup="mascaraMoeda(this, event)">
                        <span class="icon is-small is-left">
                            <i class="fa-solid fa-brazilian-real-sign"></i>
                        </span>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <partial name="Partial/_Endereco" model="Model" />

    <div class="box">
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-relato-candidato" class="label">Relato do candidato</label>
                    <div class="control">
                        <input id="txt-relato-candidato" asp-for="RelatoCandidato" type="text" name="RelatoCandidato" class="input" placeholder="Relato do candidato" maxlength="1024">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-relato-entrevistador" class="label">Relato do entrevistador</label>
                    <div class="control">
                        <input id="txt-relato-entrevistador" asp-for="RelatoEntrevistador" type="text" name="RelatoEntrevistador" class="input" placeholder="Relato do entrevistador" maxlength="1024">
                    </div>
                </div>
            </div>
        </div>
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-comentarios" class="label">Comentarios</label>
                    <div class="control">
                        <textarea id="txt-comentarios" asp-for="Comentarios" name="Comentarios" class="textarea" placeholder="Comentarios" maxlength="4000"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="columns">
        <div class="column is-offset-10">
            <div class="field is-grouped">
                <div class="control">
                    <button type="submit" class="button is-success">
                        <span class="icon">
                            <i class="fa-solid fa-user-pen"></i>
                        </span>
                        <span>Alterar</span>
                    </button>
                </div>
                <div class="control">
                    <a type="button" asp-controller="Candidato" asp-action="Index" class="button is-info is-light">
                        <span class="icon">
                            <i class="fa-solid fa-rotate-left"></i>
                        </span>
                        <span>Voltar</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

<div id="tbl-formacoes">
</div>

<div id="tbl-experiencias">
</div>

<div class="buttons">
    <button type="button" class="button is-primary" onclick="gerarParecer('@Model.Id')">
        <span class="icon">
            <i class="fa-solid fa-file-pdf"></i>
        </span>
        <span>Gerar parecer</span>
    </button>
</div>

<script src="~/js/views/candidato/formacao.js" asp-append-version="true"></script>
<script src="~/js/views/candidato/experiencia.js" asp-append-version="true"></script>
<script src="~/js/parecer-candidato.js" asp-append-version="true"></script>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        window.onload = function () {
            BuscaCep();
            $('.selectize').selectize();
            formacao.obter();
            experiencia.obter();
        }
    </script>

}