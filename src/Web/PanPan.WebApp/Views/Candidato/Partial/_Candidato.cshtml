@using PanPan.WebApp.Enums;
@using PanPan.WebApp.Extensions;
@model CandidatoViewModel

<input asp-for="Id" type="hidden" />

<div class="columns">
    <div class="column">
        <div class="field">
            <label for="txt-nome" class="label">Nome</label>
            <div class="control">
                <input id="txt-nome" asp-for="Nome" type="text" name="Nome" class="input" placeholder="Nome Sobrenome" maxlength="150">
            </div>
        </div>
    </div>
    <div class="column">
        <div class="field">
            <div class="control">
                <label class="radio">
                    <input id="radio-sexo-masculino" asp-for="Sexo" type="radio" name="Sexo" value="@Sexo.Masculino">
                    Masculino
                </label>
                <label class="radio">
                    <input id="radio-sexo-feminino" asp-for="Sexo" type="radio" name="Sexo" value="@Sexo.Feminino">
                    Feminino
                </label>
            </div>
        </div>
    </div>
</div>
<div class="columns">
    <div class="column">
        <div class="field">
            <label for="txt-email" class="label">Email</label>
            <div class="control">
                <input id="txt-email" asp-for="Email" type="email" name="Email" class="input" placeholder="email@domain.com">
            </div>
        </div>
    </div>
    <div class="column">
    </div>
</div>
<div class="columns">
    <div class="column">
        <div class="field">
            <label for="txt-telefone" class="label">Telefone</label>
            <div class="control">
                <input id="txt-telefone" asp-for="Telefone" type="text" name="Telefone" class="input" placeholder="(00) 0000-0000" data-mask="(00) 0000-0000">
            </div>
        </div>
    </div>
    <div class="column">
        <div class="field">
            <label for="txt-celular" class="label">Celular</label>
            <div class="control">
                <input id="txt-celular" asp-for="Celular" type="text" name="Celular" class="input" placeholder="(00) 90000-0000" data-mask="(00) 00000-0000">
            </div>
        </div>
    </div>
    <div class="column">
        <div class="field">
            <label for="txt-celular-alternativo" class="label">Celular alternativo</label>
            <div class="control">
                <input id="txt-celular-alternativo" asp-for="CelularAlternativo" type="text" name="CelularAlternativo" class="input" placeholder="(00) 90000-0000" data-mask="(00) 00000-0000">
            </div>
        </div>
    </div>
    <div class="column">
        <div class="field">
            <label for="slct-recrutado-por" class="label">Recrutado Por</label>
            <div class="control">
                <div>
                    <select id="slct-recrutado-por" asp-for="RecrutadoPor" name="RecrutadoPor" class="selectize" placeholder="Selecione">
                        <option></option>
                        @{
                            if (Model is not null)
                                @Html.Raw(this.SelectOptionsFontesRecrutamento(Model.RecrutadoPor))
                            else
                                @Html.Raw(this.SelectOptionsFontesRecrutamento())
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>