@using PanPan.WebApp.Enums;
@using PanPan.WebApp.Extensions;
@model CandidatoViewModel

<input asp-for="Id" type="hidden" />
<div class="col-md-6">
    <label for="txt-nome" class="form-label">Nome</label>
    <input asp-for="Nome" type="text" class="form-control" id="txt-nome" maxlength="350">
</div>
<div class="col-sm-10">
    <div class="form-check">
        <input asp-for="Sexo" class="form-check-input" type="radio" name="Sexo" id="radio-sexo-masculino" value="@Sexo.Masculino">
        <label class="form-check-label" for="radio-sexo-masculino">
            Masculino
        </label>
    </div>
    <div class="form-check">
        <input asp-for="Sexo" class="form-check-input" type="radio" name="Sexo" id="radio-sexo-feminino" value="@Sexo.Feminino">
        <label class="form-check-label" for="radio-sexo-feminino">
            Feminino
        </label>
    </div>
</div>
<div class="col-md-6">
    <label for="txt-telefone" class="form-label">Telefone</label>
    <input asp-for="Telefone" type="text" name="Telefone" id="txt-telefone" class="form-control" data-mask="(00) 0000-0000">
</div>
<div class="col-md-6">
    <label for="txt-celular" class="form-label">Celular</label>
    <input asp-for="Celular" type="text" name="Celular" id="txt-celular" class="form-control" data-mask="(00) 90000-0000">
</div>
<div class="col-md-6">
    <label for="txt-celular-alternativo" class="form-label">Celular</label>
    <input asp-for="CelularAlternativo" type="text" name="CelularAlternativo" id="txt-celular-alternativo" class="form-control" data-mask="(00) 90000-0000">
</div>
<div class="col-md-6">
    <label for="txt-email" class="form-label">E-mail</label>
    <input asp-for="Email" type="email" name="Email" id="txt-email" class="form-control" maxlength="254">
</div>
<div class="col-md-6">
    <label for="slct-recrutado-por" class="form-label">Recrutado Por</label>
    <select asp-for="RecrutadoPor" name="RecrutadoPor" id="slct-recrutado-por" class="form-select" aria-label="Recrutado Por">
        <option>Open this select menu</option>
        @{
            if (Model is not null)
                @Html.Raw(this.SelectOptionsFontesRecrutamento(Model.RecrutadoPor))
            else
                @Html.Raw(this.SelectOptionsFontesRecrutamento())
        }
    </select>
</div>



