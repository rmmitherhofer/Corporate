@using PanPan.WebApp.Models.ViewModels.Candidatos;
@model CandidatosViewModel
<div class="box">
    <div class="columns">
        <div class="column is-offset-6">
            <div class="field is-grouped">
                <div class="control has-icons-left">
                    <div class="select">
                        <select id="slct-ordernar" asp-for="OrderBy" name="OrderBy" placeholder="Selecione">
                            <option value="codigo">Codigo crescente</option>
                            <option value="-codigo">Codigo decrescente</option>
                            <option value="nome">Nome crescente</option>
                            <option value="-nome">Nome decrescente</option>
                        </select>
                    </div>
                    <span class="icon is-left">
                        <i class="fa-solid fa-arrow-up-wide-short"></i>
                    </span>
                </div>
                <div class="control has-icons-left">
                    <div class="select">
                        <select id="slct-exibir" asp-for="PageSize" name="PageSize" placeholder="Selecione">
                            <option value="10">10 por pagina</option>
                            <option value="20">20 por pagina</option>
                            <option value="30">30 por pagina</option>
                            <option value="40">40 por pagina</option>
                            <option value="50">50 por pagina</option>
                            <option value="100">100 por pagina</option>
                        </select>
                    </div>
                    <span class="icon is-left">
                        <i class="fa-solid fa-file-lines"></i>
                    </span>
                </div>
                <div class="control">
                    <button id="btn-find" type="button" class="button is-info"><i class="fa-solid fa-magnifying-glass search"></i></button>
                </div>
                <div class="control">
                    <button id="btn-clear" type="button" class="button is-info is-light clear"><i class="fa-solid fa-eraser"></i></button>
                </div>
                <div class="control">
                    <a type="button" asp-controller="Candidato" asp-action="IncluirCandidato" class="button is-primary"><i class="fa-solid fa-user-plus"></i></a>
                </div>
            </div>
        </div>
    </div>
    <table class="table is-fullwidth">
        <thead>
            <tr>
                <th>#</th>
                <th>Nome</th>
                <th>Telefone</th>
                <th>Celular</th>
                <th>Celular</th>
                <th>E-mail</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var candidato in Model.Candidatos)
            {
                <tr>
                    <th>@candidato.Codigo</th>
                    <td>@candidato.Nome</td>
                    <td>@candidato.Telefone</td>
                    <td>@candidato.Celular</td>
                    <td>@candidato.CelularAlternativo</td>
                    <td>@candidato.Email</td>
                    <td>
                        <div class="buttons">
                            <a type="button" asp-controller="Candidato" asp-action="AlterarCandidato" asp-route-id="@candidato.Id" class="button is-success is-outlined"><i class="fa-solid fa-user-pen"></i></a>
                            <a type="button" class="button is-danger is-outlined" onclick="confirmarExclusao('@candidato.Id')">
                                <i class="fa-solid fa-user-xmark"></i>
                            </a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal-excluir" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">Confirmação</p>
            <button class="delete" aria-label="close" onclick="fecharModal()"></button>
        </header>
        <section class="modal-card-body">
            Tem certeza que deseja excluir este candidato?
        </section>
        <footer class="modal-card-foot">
            <form id="form-exclusao" method="post">
                <input type="hidden" name="id" id="input-id-exclusao" />
                <button type="submit" class="button is-danger">Sim, excluir</button>
                <button type="button" class="button" onclick="fecharModal()">Cancelar</button>
            </form>
        </footer>
    </div>
</div>

<partial name="_Paginacao" model="Model" />