@using PanPan.WebApp.Enums;
@using PanPan.WebApp.Extensions;
@model FormacaoViewModel

<div class="box">
    <input id="formacao-id" asp-for="Id" value="@Model.Id" type="hidden" />
    <div class="columns">
        <div class="column">
            <div class="field">
                <label for="txt-instituicao" class="label">Instituicao</label>
                <div class="control">
                    <input id="txt-instituicao" type="text" name="NomeInstituicao" class="input" placeholder="Instituicao" maxlength="150">
                </div>
            </div>
        </div>
        <div class="column">
            <div class="field">
                <label for="txt-descricao" class="label">Descricao do curso</label>
                <div class="control">
                    <input id="txt-descricao" type="text" name="Descricao" class="input" placeholder="Descricao do curso" maxlength="150">
                </div>
            </div>
        </div>
    </div>
    <div class="columns">
        <div class="column">
            <div class="field">
                <div class="control">
                    <label class="radio">
                        <input id="radio-tipo-formacao-ensino" type="radio" name="Tipo" value="@TipoFormacao.Ensino">
                        Ensino
                    </label>
                    <label class="radio">
                        <input id="radio-tipo-formacao-curso" type="radio" name="Tipo" value="@TipoFormacao.Curso">
                        Curso
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div id="tab-radio-tipo-formacao-ensino" class="ai-form-tab-content" ai-form-tab="radio-tipo-formacao-ensino">
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="slct-ensino" class="label">Tipo de ensino</label>
                    <div class="control">
                        <div>
                            <select id="slct-ensino" name="Ensino" class="selectize" placeholder="Selecione">
                                <option></option>
                                @{
                                    if (Model is not null)
                                        @Html.Raw(this.SelectOptionsEnsino(Model.Ensino))
                                    else
                                        @Html.Raw(this.SelectOptionsEnsino())
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="tab-radio-tipo-formacao-curso" class="ai-form-tab-content" ai-form-tab="radio-tipo-formacao-curso">
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="slct-curso" class="label">Curso</label>
                    <div class="control">
                        <div>
                            <select id="slct-curso" name="Curso" class="selectize" placeholder="Selecione">
                                <option></option>
                                @{
                                    if (Model is not null)
                                        @Html.Raw(this.SelectOptionsCurso(Model.Curso))
                                    else
                                        @Html.Raw(this.SelectOptionsCurso())
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="columns">
        <div class="column">
            <div class="field">
                <label for="slct-periodo" class="label">Periodo</label>
                <div class="control">
                    <div>
                        <select id="slct-periodo" name="Periodo" class="selectize" placeholder="Selecione">
                            <option></option>
                            @{
                                if (Model is not null)
                                    @Html.Raw(this.SelectOptionsPeriodoFormacao(Model.Periodo))
                                else
                                    @Html.Raw(this.SelectOptionsPeriodoFormacao())
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="column">
            <div class="field">
                <label for="txt-data-inicio" class="label">Inicio</label>
                <div class="control">
                    <input id="txt-data-inicio" type="text" name="DataInicioString" class="input" placeholder="00/0000" data-mask="00/0000">
                </div>
            </div>
        </div>
        <div class="column">
            <div class="field">
                <label for="txt-data-fim" class="label">Conclusao</label>
                <div class="control">
                    <input id="txt-data-fim" type="text" name="DataFimString" class="input" placeholder="00/0000" data-mask="00/0000">
                </div>
            </div>
        </div>

        <div class="column">
            <div class="field">
                <label for="slct-status" class="label">Status</label>
                <div class="control">
                    <div>
                        <select id="slct-status" name="Status" class="selectize" placeholder="Selecione">
                            <option></option>
                            @{
                                if (Model is not null)
                                    @Html.Raw(this.SelectOptionsStatusFormacao(Model.Status))
                                else
                                    @Html.Raw(this.SelectOptionsStatusFormacao())
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
