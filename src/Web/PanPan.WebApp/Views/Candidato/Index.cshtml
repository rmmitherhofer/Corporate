@using PanPan.WebApp.Extensions;
@model CandidatosViewModel

@{
    ViewData["Title"] = "Candidatos";
}

<form asp-controller="Candidato" asp-action="Index" method="get" class="">
    <div class="box">
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-nome" class="label">Nome</label>
                    <div class="control">
                        <input id="txt-nome" asp-for="Nome" type="text" name="Nome" class="input" placeholder="Nome Sobrenome">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-email" class="label">Email</label>
                    <div class="control">
                        <input id="txt-email" asp-for="Email" type="text" name="Email" class="input email-helper" placeholder="email@domain.com">
                    </div>
                </div>
            </div>
        </div>
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-telefone" class="label">Telefone</label>
                    <div class="control">
                        <input id="txt-telefone" asp-for="Telefone" type="text" name="Telefone" class="input" placeholder="(00) 0000-0000" data-mask="(00) 0000-0000">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-celular" class="label">Celular</label>
                    <div class="control">
                        <input id="txt-celular" asp-for="Celular" type="text" name="Celular" class="input" placeholder="(00) 90000-0000" data-mask="(00) 00000-0000">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="txt-celular-alternativo" class="label">Celular alternativo</label>
                    <div class="control">
                        <input id="txt-celular-alternativo" asp-for="CelularAlternativo" type="text" name="CelularAlternativo" class="input" placeholder="(00) 90000-0000" data-mask="(00) 00000-0000">
                    </div>
                </div>
            </div>
        </div>
        <div class="columns">
            <div class="column">
                <div class="field">
                    <label for="txt-bairro" class="label">Bairro</label>
                    <div class="control">
                        <input id="txt-bairro" asp-for="Bairro" type="text" name="Bairro" class="input" placeholder="Bairro">
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="slct-estado" class="label">Estado</label>
                    <div class="control">
                        <div id="sec-estado">
                            <select id="slct-estado" asp-for="Estado" name="Estado" class="selectize" placeholder="Selecione" onchange="buscaCidades(this.value, 'slct-cidade', '@(Model is not null ? "reload" : "load")')">
                                <option></option>
                                @{
                                    if (Model is not null)
                                        @Html.Raw(this.SelectOptionsEstados(Model.Estado))
                                    else
                                        @Html.Raw(this.SelectOptionsEstados())
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label for="slct-cidade" class="label">Cidade</label>
                    <div class="control">
                        <div id="sec-cidade">
                            <select id="slct-cidade" asp-for="Cidade" name="Cidade" class="selectize" placeholder="Selecione">
                                <option></option>
                                @{
                                    if (Model is not null)
                                        @Html.Raw(this.SelectOptionsCidades(Model.Estado, Model.Cidade))
                                    else
                                        @Html.Raw(this.SelectOptionsCidades())
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-content">
        <partial name="Partial/_Candidatos" model="Model" />
    </div>

</form>
<script src="~/js/cidades.js" asp-append-version="true"></script>
<script src="~/js/views/candidato/index.js" asp-append-version="true"></script>
<script>
    $(function () {
        $('.selectize').selectize();
    });
</script>