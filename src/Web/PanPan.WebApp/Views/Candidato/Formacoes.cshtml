@using Extensions;
@using PanPan.WebApp.Enums;
@model IEnumerable<FormacaoViewModel>

<div class="box">
    <div class="buttons">
        <button type="button" class="button is-primary js-modal-trigger" data-target="nova-formacao">
            <span class="icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </span>
        </button>
    </div>
    <table class="table is-fullwidth">
        <thead>
            <tr>
                <th>Formacao</th>
                <th>Instituicao</th>
                <th>Descricao</th>
                <th>Status</th>
                <th>Inicio</th>
                <th>Conclusao</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var formacao in Model.OrderByDescending(f => f.DataInicio)?.ThenByDescending(f => f.DataFim))
                {
                    <tr>
                        @if (formacao.Tipo == TipoFormacao.Ensino)
                        {
                            <td>@formacao.Ensino.Value.Descricao()</td>
                        }
                        else
                        {
                            <td>@formacao.Curso.Value.Descricao()</td>
                        }
                        <td>@formacao.NomeInstituicao</td>
                        <th scope="row">@formacao.Descricao</th>
                        <td>@formacao.Status.Descricao()</td>
                        <td>@formacao.DataInicioString</td>
                        <td>@formacao.DataFimString</td>
                        <td>
                            <div class="buttons">
                                <button type="button" class="button is-success is-outlined js-modal-trigger" data-target="@formacao.Id"><i class="fa-solid fa-pencil"></i></button>
                                <a type="button" asp-controller="Candidato" asp-action="RemoverFormacao" asp-route-id="@formacao.CandidatoId" asp-route-formacaoId="@formacao.Id" class="button is-danger is-outlined"><i class="fa-solid fa-xmark"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>


    <div id="nova-formacao" class="modal new-formacao">
        <div class="modal-background"></div>
        <div class="modal-card">
            <div class="modal-content">
                <partial name="IncluirFormacao" model="Model.Select(f => f.CandidatoId).FirstOrDefault()" />
            </div>
        </div>
    </div>



    @if (Model != null)
    {
        @foreach (var formacao in Model)
        {
            <partial name="AlterarFormacao" model="formacao" />
        }
    }
</div>