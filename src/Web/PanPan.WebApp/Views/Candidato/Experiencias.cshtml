@using Extensions;
@using PanPan.WebApp.Models.ViewModels.Candidatos;
@model IEnumerable<ExperienciaViewModel>

<div class="box">
    <div class="buttons">
        <button type="button" class="button is-primary js-modal-trigger" data-target="nova-experiencia">
            <span class="icon">
                <i class="fa-solid fa-briefcase"></i>
            </span>
        </button>
    </div>
    <table class="table is-fullwidth">
        <thead>
            <tr>
                <th>Empresa</th>
                <th>Cargo</th>
                <th>Status</th>
                <th>Inicio</th>
                <th>Conclusao</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var experiencia in Model.OrderByDescending(e => e.DataInicio).ThenByDescending(e => e.DataFim))
                {
                    <tr>
                        <th scope="row">@experiencia.Empresa</th>
                        <td>@experiencia.Cargo</td>
                        <td>@experiencia.Status.Descricao()</td>
                        <td>@experiencia.DataInicioString</td>
                        <td>@experiencia.DataFimString</td>
                        <td>
                            <div class="buttons">
                                <button type="button" class="button is-success is-outlined js-modal-trigger" data-target="@experiencia.Id"><i class="fa-solid fa-pencil"></i></button>
                                <a type="button" asp-controller="Candidato" asp-action="RemoverExperiencia" asp-route-id="@experiencia.CandidatoId" asp-route-experienciaId="@experiencia.Id" class="button is-danger is-outlined"><i class="fa-solid fa-xmark"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


<div id="nova-experiencia" class="modal new-experiencia">
    <div class="modal-background"></div>
    <div class="modal-card">
        <div class="modal-content">
            <partial name="IncluirExperiencia" model="Model.Select(f => f.CandidatoId).FirstOrDefault()" />
        </div>
    </div>
</div>



@if (Model != null)
{
    @foreach (var experiencia in Model)
    {
        <partial name="AlterarExperiencia" model="experiencia" />
    }
}