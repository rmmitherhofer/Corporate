@using PanPan.WebApp.Enums;
@using PanPan.WebApp.Extensions;
@model Guid


<div class="box">
    <partial name="Partial/_Formacao" model="new FormacaoViewModel(){CandidatoId = Model}" />
    <div class="columns">
        <div class="column">
            <div class="field is-grouped">
                <div class="control">
                    <button id="btn-new-formacao" type="button" class="button is-success">
                        <span class="icon">
                            <i class="fa-solid fa-plus"></i>
                        </span>
                        <span>Incluir</span>
                    </button>
                </div>
                <div class="control">
                    <button type="button" class="button is-info is-light back">
                        <span class="icon">
                            <i class="fa-solid fa-rotate-left"></i>
                        </span>
                        <span>Voltar</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>