@using PanPan.WebApp.Enums;
@using PanPan.WebApp.Extensions;
@using PanPan.WebApp.Models.ViewModels.Candidatos;
@model CandidatoViewModel

<form asp-controller="Candidato" asp-action="IncluirCandidato" method="post" class="row g-3">
    <partial name="Partial/_Candidato" model="Model" />
    <partial name="Partial/_Endereco" model="Model" />
    <div class="columns">
        <div class="column is-offset-8">
            <div class="field is-grouped">
                <div class="control">
                    <a type="button" asp-controller="Candidato" asp-action="JsonResumeImport" class="button is-success">
                        <span class="icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </span>
                        <span>Importar Json</span>
                    </a>
                </div>
                <div class="control">
                    <button type="submit" class="button is-success">
                        <span class="icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </span>
                        <span>Incluir</span>
                    </button>
                </div>
                <div class="control">
                    <a type="button" asp-controller="Candidato" asp-action="Index" class="button is-info is-light">
                        <span class="icon">
                            <i class="fa-solid fa-rotate-left"></i>
                        </span>
                        <span>Voltar</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    #loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* fundo cinza transparente */
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    /* Loader simples (pode trocar por spinner) */
    .loader {
        border: 8px solid #f3f3f3;
        border-top: 8px solid #007bff;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {        transform: rotate(0deg);    }
        100% {        transform: rotate(360deg);    }
    }
</style>

<form asp-controller="Candidato" asp-action="ImportarCurriculo" method="post" role="form" enctype="multipart/form-data" onsubmit="showLoading()">
    <div class="field is-grouped is-align-items-center is-justify-content-flex-start">
        <!-- Upload com botão discreto -->
        <p class="control">
            <div class="file is-small is-info">
                <label class="file-label">
                    <input class="file-input" type="file" asp-for="File" id="resumeFile">
                    <span class="file-cta">
                        <span class="file-icon">
                            <i class="fas fa-upload"></i>
                        </span>
                        <span class="file-label">Escolher</span>
                    </span>
                </label>
            </div>
        </p>

        <!-- Nome do arquivo -->
        <p class="control">
            <span class="tag is-light is-small" id="fileNameDisplay" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Nenhum arquivo</span>
        </p>

        <!-- Botão Importar -->
        <p class="control">
            <button class="button is-primary is-small">Importar</button>
        </p>
    </div>
</form>

<div id="loading-overlay">
    <div class="loader"></div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            BuscaCep();
            $('.selectize').selectize();

            const fileInput = document.getElementById('resumeFile');
            const fileNameDisplay = document.getElementById('fileNameDisplay');

            fileInput.addEventListener('change', function () {
              fileNameDisplay.textContent = this.files.length > 0 ? this.files[0].name : 'Nenhum arquivo';
            });
        });

        function showLoading() {
          document.getElementById('loading-overlay').style.display = 'flex';
        }
    </script>
}

