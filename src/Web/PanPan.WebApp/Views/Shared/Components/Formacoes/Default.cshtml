@using Extensions;
@using PanPan.WebApp.Enums;
@model IEnumerable<FormacaoViewModel>

<div class="box">
    <div class="buttons">
        <a type="button" asp-controller="Candidato" asp-action="IncluirFormacao" asp-route-id="@Model.Select(f => f.CandidatoId).FirstOrDefault()" class="button is-primary">
            <span class="icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </span>
        </a>
    </div>
    <table class="table is-fullwidth">
        <thead>
            <tr>
                <th>Formacao</th>
                <th>Instituicao</th>
                <th>Descricao</th>
                <th>Status</th>
                <th>Inicio</th>
                <th>Conclusao</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var formacao in Model.OrderByDescending(f => f.DataInicio)?.ThenByDescending(f => f.DataFim))
                {
                    <tr>
                        @if (formacao.Tipo == TipoFormacao.Ensino)
                        {
                            <td>@formacao.Ensino.Value.Descricao()</td>
                        }
                        else
                        {
                            <td>@formacao.Curso.Value.Descricao()</td>
                        }
                        <td>@formacao.NomeInstituicao</td>
                        <th scope="row">@formacao.Descricao</th>
                        <td>@formacao.Status.Descricao()</td>
                        <td>@formacao.DataInicioString</td>
                        <td>@formacao.DataFimString</td>
                        <td>
                            <div class="buttons">
                                <a type="button" asp-controller="Candidato" asp-action="AlterarFormacao" asp-route-id="@formacao.CandidatoId" asp-route-formacaoId="@formacao.Id" class="button is-success is-outlined"><i class="fa-solid fa-pencil"></i></a>
                                <a type="button" asp-controller="Candidato" asp-action="RemoverFormacao" asp-route-id="@formacao.CandidatoId" asp-route-formacaoId="@formacao.Id" class="button is-danger is-outlined"><i class="fa-solid fa-xmark"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
