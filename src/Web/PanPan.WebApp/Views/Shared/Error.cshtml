@using PanPan.WebApp.Models.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = $"Erro {Model.ErrorCode}";
}


<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Seu Sistema</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            text-align: center;
            padding: 50px;
        }

        .error-container {
            background-color: white;
            padding: 40px;
            margin: auto;
            max-width: 600px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        .error-code {
            font-size: 72px;
            color: #dc3545;
        }

        .error-title {
            font-size: 28px;
            margin: 20px 0;
        }

        .error-message {
            font-size: 18px;
            color: #555;
        }

        .correlation-id {
            margin-top: 20px;
            font-size: 12px;
            color: #999;
        }
    </style>
</head>
<div class="error-container">
    <div class="error-code">@Model.ErrorCode</div>
    <div class="error-title">@Model.Title ?? "Ocorreu um erro"</div>
    <div class="error-message">@Model.Message ?? "Estamos trabalhando para resolver o problema."</div>

    @if (!string.IsNullOrEmpty(Model.CorrelationId))
    {
        <div class="correlation-id">
            Código de rastreamento: <strong>@Model.CorrelationId</strong>
        </div>
    }
</div>