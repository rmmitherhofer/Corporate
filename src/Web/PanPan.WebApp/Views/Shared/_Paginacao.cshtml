@model PageViewModel

<nav class="pagination is-centered" role="navigation" aria-label="pagination">
    @{
        if (Model.BackPage is not null)
        {
            <button value="@Model.BackPage" class="pagination-previous search">Anterior</button>
        }
        else
        {
            <button class="pagination-previous is-disabled">Anterior</button>
        }

        if (Model.NextPage is not null)
        {
            <button value="@Model.NextPage" class="pagination-next search">Proxima</button>
        }
        else
        {
            <button class="pagination-next is-disabled">Proxima</button>
        }

        <ul class="pagination-list">

            @if (Model.BackPage is not null)
            {
                <li>
                    <button value="1" class="pagination-link search" aria-label="Goto page 1">1</button>
                </li>
                <li>
                    <span class="pagination-ellipsis">&hellip;</span>
                </li>
            }

            @if (Model.PageCount == 1)
            {
                <li>
                    <button class="pagination-link is-current" aria-label="Page @Model.PageNumber" aria-current="page">@Model.PageNumber</button>
                </li>
            }
            else
            {
                @if (Model.PageNumber == 1)
                {
                    <li>
                        <button class="pagination-link is-current" aria-label="Page @Model.PageNumber" aria-current="page">@Model.PageNumber</button>
                    </li>

                    <li>
                        <button value="@Model.NextPage" class="pagination-link search" aria-label="Goto page @Model.NextPage">@Model.NextPage</button>
                    </li>

                    @if (Model.PageCount > 2)
                    {
                        <li>
                            <button value="@(Model.NextPage + 1)" class="pagination-link search" aria-label="Goto page @(Model.NextPage + 1)">@(Model.NextPage + 1)</button>
                        </li>
                    }

                }
                else
                {
                    @if (Model.PageNumber == Model.PageCount)
                    {
                        @if (Model.PageCount > 2)
                        {
                            <li>
                                <button value="@(Model.BackPage - 1)" class="pagination-link search" aria-label="Goto page @(Model.BackPage - 1)">@(Model.BackPage - 1)</button>
                            </li>
                        }

                        <li>
                            <button value="@(Model.BackPage)" class="pagination-link search" aria-label="Goto page @Model.BackPage">@Model.BackPage</button>
                        </li>


                        <li>
                            <button class="pagination-link is-current" aria-label="Page @Model.PageNumber" aria-current="page">@Model.PageNumber</button>
                        </li>
                    }
                    else
                    {
                        <li>
                            <button value="@(Model.BackPage)" class="pagination-link search" aria-label="Goto page @Model.BackPage">@Model.BackPage</button>
                        </li>

                        <li>
                            <button class="pagination-link is-current" aria-label="Page @Model.PageNumber" aria-current="page">@Model.PageNumber</button>
                        </li>

                        <li>
                            <button value="@(Model.NextPage)" class="pagination-link search" aria-label="Goto page @Model.NextPage">@Model.NextPage</button>
                        </li>
                    }
                }
            }
            @if (Model.NextPage is not null)
            {
                <li>
                    <span class="pagination-ellipsis">&hellip;</span>
                </li>
                <li>
                    <button value="@(Model.PageCount)" class="pagination-link search" aria-label="Goto page @Model.PageCount">@Model.PageCount</button>
                </li>
            }
        </ul>
    }
</nav>